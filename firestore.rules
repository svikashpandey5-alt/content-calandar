rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assets collection
    match /assets/{document} {
      allow read, write: if request.auth != null;
    }

    // Config collection
    match /config/{document} {
      allow read, write: if request.auth != null;
    }

    // CalendarDays collection
    match /calendarDays/{document} {
      allow read, write: if request.auth != null;
    }

    // Counters collection
    match /counters/{document} {
      allow read, write: if request.auth != null;
    }

    // Users collection
    match /users/{document} {
      allow read, write: if request.auth != null;
    }

    // Public collection to track UTM clicks on the Link-in-Bio page
    match /linkClicks/{document} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // Secrets collection - strictly deny all client-side read/write.
    // Cloud Functions Admin SDK bypasses these rules.
    match /secrets/{document} {
      allow read, write: if false;
    }
  }
}
